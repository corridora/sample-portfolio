# Optional environment input for ./setup configure --non-interactive.
# The wizard saves configuration in .sample/*.json; it does not automatically source .env.
SAMPLE_MODE=local
PORT=4105
CORRIDORA_TARGET=own
CORRIDORA_OTLP_ENDPOINT=https://ingest.corridora.com
CORRIDORA_RUM_ENDPOINT=https://ingest.corridora.com
CORRIDORA_INGEST_KEY=
CORRIDORA_RUM_KEY=
CORRIDORA_RUM_SCRIPT_URL=https://rum.corridora.com/corridora-rum.js
OTEL_SERVICE_NAME=sample-portfolio-api
OTEL_SERVICE_NAMESPACE=corridora-samples.portfolio
DEPLOYMENT_ENVIRONMENT=development
DEMO_CONTROL_TOKEN=
DEMO_DAILY_START_UTC=14:20
DEMO_WINDOW_SECONDS=600
ENABLE_PROVIDER_FORWARDING=false
ENABLE_SYNTHETICS=false
PRICE_FIXTURE_URL=
DOWNSTREAM_AUTH_TOKEN=
TRACKER_SIMULATOR_URL=
LINODE_TOKEN=
LINODE_STATS_TOKEN=
LINODE_REGION=us-ord
RESOURCE_PREFIX=sample-portfolio
LINODE_EXISTING_ID=
LINODE_HOST=
SSH_USER=root
SSH_KEY_PATH=
SSH_ALLOWED_CIDR=
TLS_HOSTNAME=
COLLECTOR_MEMORY_MB=128
LINODE_STATS_INTERVAL_SECONDS=900
