{
  "name": "@corridora/sample-portfolio", "private": true, "version": "1.0.0", "type": "module",
  "scripts": {
    "build": "esbuild resources/app.js --bundle --format=iife --outfile=public/assets/app.js && node scripts/copy-assets.mjs",
    "test:browser": "playwright test",
    "test": "python3 -m unittest discover -s tests -p 'test_*.py' && php tests/unit.php && node --test tests/schedule.test.mjs"
  },
  "dependencies": { "@opentelemetry/api": "1.9.0", "htmx.org": "2.0.8" },
  "devDependencies": { "@playwright/test": "1.56.0", "esbuild": "0.25.10" }
}
